# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# signing credentials, never commit
credentials.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# shop import working files: regenerated by scripts/import_shops.py, reviewed, then applied
scripts/out/

# Python caches created when the import script or its tests run
__pycache__/
*.pyc
